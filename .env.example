# MOMÉRA Environment Configuration

# Server Environment
NODE_ENV=development
PORT=3001

# URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Database Configuration
# Modes: "local" (better-sqlite3) | "d1" (Cloudflare D1 mock or binding)
DATABASE_MODE=local
DATABASE_PATH=./data/momera.sqlite

# Authentication & Sessions
SESSION_SECRET=momera_dev_super_secret_session_key_min_32_characters_long_12345
SESSION_TTL_HOURS=24

# Initial Admin Bootstrap (Used on first run if no admin exists)
ADMIN_BOOTSTRAP_EMAIL=admin@momera.in
ADMIN_BOOTSTRAP_PASSWORD=RoyalMomeraAdmin2026!

# Business Settings Defaults
BRAND_NAME=MOMÉRA
BRAND_TAGLINE="Every Moment Deserves a Crown."
BUSINESS_PHONE=+919876543210
WHATSAPP_CONTACT_NUMBER=+919876543210
NOTIFICATION_RECIPIENT_NUMBER=+919876543210
BUSINESS_EMAIL=concierge@momera.in
SERVICE_COVERAGE="Coimbatore, Tamil Nadu, India"
BUSINESS_HOURS="Monday to Sunday: 09:00 AM - 09:00 PM IST"

# WhatsApp Notification Provider
# Options: "manual" (default outbox logging with click-to-chat links) | "cloud_api"
WHATSAPP_NOTIFICATION_PROVIDER=manual
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=momera_enquiry_alert
